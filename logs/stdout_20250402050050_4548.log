      VALUES (i.[BillID], i.[ChallanNo], i.[DeliveryNum], i.[Destination], i.[DisVid], i.[DispatchDate], i.[DispatchQuantity], i.[FinalPrice], i.[IsReceived], i.[Lr], i.[PartyName], i.[Shortage], i.[TotalValue], i.[UnitPrice], i.[UpdatedAt], i.[VehicleNo])
      OUTPUT INSERTED.[DispId], i._Position
      INTO @inserted0;
      
      SELECT [i].[DispId] FROM @inserted0 i
      ORDER BY [i].[_Position];

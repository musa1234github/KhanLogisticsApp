@model IEnumerable<KhanLogistics.Models.ViewModel.SpOutStanding>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Outstanding Details</title>
    <!-- DataTables CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">
    <!-- DataTables Buttons CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css">
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
</head>
<body>
    <h1 style="text-align:center">View Outstanding Details</h1>
    <style>
        .form-container {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .form-container > div {
            flex: 1;
            margin-right: 10px;
        }
        .form-container label {
            display: block;
            margin-bottom: 5px;
        }
    </style>

    <div class="form-container">
        <div>
            <label for="fromDate">From Date:</label>
            <input type="date" id="fromDate" name="fromDate">
        </div>
        <div>
            <label for="toDate">To Date:</label>
            <input type="date" id="toDate" name="toDate">
        </div>
        <div>
            <label for="factory">Select Factory:</label>
            <select id="factory" name="factory">
                <option value="">All Factories</option>
            </select>
        </div>
    </div>
    <button id="GetAllDetails">Filter Outstanding Details</button>

    <div id="DtTable">
        <table id="tblOutstandingDetails" class="display" style="width:100%">
            <thead>
                <tr>
                    <th>Factory Name</th>
                    <th>Bill Number</th>
                    <th>Bill Date</th>
                    <th>Bill Age</th>
                    <th>Bill Type</th>
                    <th>Actual Amount</th>
                    <th>Dispatch Month</th>
                    <th>Payment Received</th>
                </tr>
            </thead>
            <tbody id="tblOutstandingDetailsBody">
                <!-- Table rows will be populated here -->
            </tbody>
        </table>
    </div>

    <!-- DataTables JavaScript -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <!-- DataTables Buttons JavaScript -->
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#tblOutstandingDetails').hide();

            function loadFactories() {
                $.ajax({
                    type: "GET",
                    url: "/Rep/GetFactories",
                    dataType: "json",
                    success: function (resultData) {
                        var factoryDropdown = $('#factory');
                        factoryDropdown.empty();
                        factoryDropdown.append($('<option>', {
                            value: '',
                            text: 'All Factories'
                        }));
                        $.each(resultData, function (index, factory) {
                            factoryDropdown.append($('<option>', {
                                value: factory.id,
                                text: factory.name
                            }));
                        });
                    },
                    error: function (xhr, status, error) {
                        console.error(xhr.responseText);
                    }
                });
            }

            loadFactories();

            $('#GetAllDetails').on('click', function () {
                loadGridDataAjax();
            });

            function loadGridDataAjax() {
                var fromDate = $('#fromDate').val();
                var toDate = $('#toDate').val();
                var factoryId = $('#factory').val();
                $.ajax({
                    type: "POST",
                    url: "/Rep/LoadOutstandingDetails",
                    data: { fromDate: fromDate, toDate: toDate, factoryId: factoryId },
                    dataType: "json",
                    success: function (resultData) {
                        console.log(resultData);  // Log the raw JSON response

                        var htmlResult = "";
                            $.each(resultData, function (index, rowData) {
                            htmlResult += "<tr>";
                            htmlResult += "<td>" + (rowData.factoryName || '') + "</td>";
                            htmlResult += "<td>" + rowData.billNum + "</td>";

                            var billDate = new Date(rowData.billDate);
                            var day = ('0' + billDate.getDate()).slice(-2); // Get day and pad with leading zero if necessary
                            var month = ('0' + (billDate.getMonth() + 1)).slice(-2); // Get month (add 1 because months are zero-indexed) and pad with leading zero if necessary
                            var year = billDate.getFullYear().toString().slice(-2); // Get year and slice to get last two digits

                            var formattedBillDate = day + '-' + month + '-' + year;
                            htmlResult += "<td>" + formattedBillDate + "</td>";
                            htmlResult += "<td>" + (rowData.invoiceAge !== null ? rowData.invoiceAge : 'N/A') + "</td>";

                            htmlResult += "<td>" + (rowData.billType || '') + "</td>";
                            htmlResult += "<td>" + (rowData.actualAmount !== null ? rowData.actualAmount.toFixed(2) : '') + "</td>";
                            htmlResult += "<td>" + (rowData.dispatchMonth || '') + "</td>";
                            htmlResult += "<td>" + (rowData.paymentReceived !== null ? rowData.paymentReceived.toFixed(2) : '0') + "</td>";
                            htmlResult += "</tr>";
                        });


                        $('#tblOutstandingDetailsBody').html(htmlResult);
                        $('#tblOutstandingDetails').show();
                        initializeDataTable();
                    },
                    error: function (xhr, status, error) {
                        console.error(xhr.responseText);
                    }
                });
            }

            function initializeDataTable() {
                if ($.fn.DataTable.isDataTable('#tblOutstandingDetails')) {
                    $('#tblOutstandingDetails').DataTable().destroy();
                }

                $('#tblOutstandingDetails').DataTable({
                    dom: 'Bfrtip',
                    buttons: [
                        'copy', 'csv', 'excel', 'pdf', 'print'
                    ],
                    deferRender: true
                });
            }
        });
    </script>
</body>
</html>

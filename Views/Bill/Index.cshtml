@model IEnumerable<KhanLogistics.Models.ViewModel.BillDispatchViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1 style="text-align:center">GST</h1>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Factory</label>
                <select name="factoryId" class="form-select">
                    <option value="">-- All Factories --</option>
                    @foreach (var factory in (IEnumerable<SelectListItem>)ViewBag.Factories)
                    {
                        <option value="@factory.Value" selected="@(factory.Value == ViewBag.SelectedFactoryId?.ToString())">@factory.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">GST Rec. Start Date</label>
                <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label">GST Rec. End Date</label>
                <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-secondary w-100">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="mb-3 text-end">
    <a asp-action="ExportIndexExcel" 
       asp-route-factoryId="@ViewBag.SelectedFactoryId" 
       asp-route-startDate="@ViewBag.StartDate" 
       asp-route-endDate="@ViewBag.EndDate" 
       class="btn btn-success">
       <i class="bi bi-file-earmark-excel"></i> Export to Excel
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <p>No bills available.</p>
}
else
{
    <table class="table" id="Mytable">
        <thead>
            <tr>
                <th>Factory Name</th>
                <th>Bill Number</th>
                <th>Bill Date</th>
                <th>Bill Type</th>
                <th>Gst</th>
                <th>Gst Received Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FactoryName</td>
                    <td>@item.BillNum</td>
                    <td>@item.BillDate?.ToString("yyyy-MM-dd")</td>
                    <td>@item.BillType</td>
                    <td>@(item.Gst?.ToString("F2") ?? "0.00")</td>
                    <td>@item.GstDate?.ToString("yyyy-MM-dd")</td>
                    <td>
                        @Html.ActionLink("Detail", "Details", new { id = item.BillID }) |
                        <a asp-action="Edit" asp-route-id="@item.BillID">Edit</a> |
                        <form asp-action="Delete" asp-route-id="@item.BillID" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this bill? Linked dispatches will be unlinked.');">
                            <button type="submit" class="btn btn-link p-0 text-danger" style="vertical-align: baseline;">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

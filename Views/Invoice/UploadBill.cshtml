@using System.Collections.Generic
@model KhanLogistics.Models.ViewModel.DispatchVm

<h1 style="text-align:center">Upload Bill</h1>

@if (TempData["SuccessCount"] != null && TempData["FailureCount"] != null)
{
    <div class="alert alert-info">
        <strong>Upload Summary:</strong><br />
        Records Uploaded Successfully: @TempData["SuccessCount"]<br />
        Records Failed to Upload: @TempData["FailureCount"]
        @if (TempData["FailedRecords"] is List<string> failedRecords && failedRecords.Count > 0)
        {
            <br />
            <strong>Failed Record IDs:</strong> @string.Join(", ", failedRecords)
        }
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @TempData["ErrorMessage"]
    </div>
}

<form asp-controller="Invoice" asp-action="UploadBill" method="post" enctype="multipart/form-data">
    <div class="form-group" style="margin-bottom: 15px;">
        <label for="ddlFactory">Select Factory:</label>
        <select name="selectedFactoryId" id="ddlFactory" class="form-control">
            <option value="">-- Select Factory --</option>
            @foreach (var factory in Model.ddlFactory)
            {
                <option value="@factory.Value">@factory.Text</option>
            }
        </select>
    </div>
    <div class="form-group" style="margin-bottom: 15px;">
        <label for="file">Select Excel File to Upload:</label>
        <input type="file" name="file" id="file" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bill Export</title>
    <!-- DataTables CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">
    <!-- DataTables Buttons CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css">
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
</head>
<body>
    <h1 style="text-align:center">Bill Export</h1>
    <style>
        .form-container {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

            .form-container > div {
                flex: 1;
                margin-right: 10px;
            }

            .form-container label {
                display: block;
                margin-bottom: 5px;
            }
    </style>

    <div class="form-container">
        <div>
            <label for="fromDate">From Date:</label>
            <input type="date" id="fromDate" name="fromDate">
        </div>
        <div>
            <label for="toDate">To Date:</label>
            <input type="date" id="toDate" name="toDate">
        </div>
        <div>
            <label for="factory">Select Factory:</label>
            <select id="factory" name="factory">
                <option value="">All Factories</option>
            </select>
        </div>
    </div>
    <button id="GetAllDetails">Export Bill Details</button>

    <div id="DtTable">
        <table id="tblBillDetails" class="display" style="width:100%">
            <thead>
                <tr>
                    <th>Factory Name</th>
                    <th>Destination</th>
                    <th>LR NUM</th>
                    <th>Bill Num</th>
                    <th>Bill Date</th>
                    <th>Dispatch Date</th>
                    <th>Bill Type</th>
                    <th>Vehicle No</th>
                    <th>Dispatch Quantity</th>
                    <th>Unit Price</th>
                    <th>Total Price</th>
                    <th>Final Price</th>
                    <th>Difference</th>
                </tr>
            </thead>
            <tbody id="tblBillDetailsBody">
                <!-- Table rows will be populated here -->
            </tbody>
        </table>
    </div>

    <!-- DataTables JavaScript -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <!-- DataTables Buttons JavaScript -->
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#tblBillDetails').hide();

            function loadFactories() {
                $.ajax({
                    type: "GET",
                    url: "/Report/GetFactories", // Updated URL
                    dataType: "json",
                    success: function (resultData) {
                        var factoryDropdown = $('#factory');
                        factoryDropdown.empty();
                        factoryDropdown.append($('<option>', {
                            value: '',
                            text: 'All Factories'
                        }));
                        $.each(resultData, function (index, factory) {
                            factoryDropdown.append($('<option>', {
                                value: factory.id,
                                text: factory.name
                            }));
                        });
                    },
                    error: function (xhr, status, error) {
                        console.error(xhr.responseText);
                    }
                });
            }

            loadFactories();

            $('#GetAllDetails').on('click', function () {
                loadGridDataAjax();
            });

            function loadGridDataAjax() {
                var fromDate = $('#fromDate').val();
                var toDate = $('#toDate').val();
                var factoryId = $('#factory').val();
                $.ajax({
                    type: "POST",
                    url: "/Report/LoadBillsToExport", // Updated URL
                    data: { fromDate: fromDate, toDate: toDate, factoryId: factoryId },
                    dataType: "json",
                    success: function (resultData) {
                        var htmlResult = "";
                      
                        $.each(resultData, function (index, rowData) {
                            htmlResult += "<tr>";
                            htmlResult += "<td>" + (rowData.factoryName || 'N/A') + "</td>"; // Handling missing data
                            htmlResult += "<td>" + (rowData.destination || 'N/A') + "</td>"; // Handling missing data
                            
                            htmlResult += "<td>" + (rowData.challanNo || 'N/A') + "</td>";
                            htmlResult += "<td>" + (rowData.billNum || 'N/A') + "</td>";

                            // Handling potential invalid date formats
                            var billDate = new Date(rowData.billDate);
                            var formattedDate = isNaN(billDate.getTime()) ? 'Invalid Date' : billDate.toLocaleDateString('en-US');
                            htmlResult += "<td>" + formattedDate + "</td>";

                            var dispatchDate = new Date(rowData.dispatchDate);
                            var formattedDispatchDate = isNaN(dispatchDate.getTime()) ? 'Invalid Date' : dispatchDate.toLocaleDateString('en-US');
                            htmlResult += "<td>" + formattedDispatchDate + "</td>";

                            htmlResult += "<td>" + (rowData.billType || 'N/A') + "</td>";
                            htmlResult += "<td>" + (rowData.vehicleNo || 'N/A') + "</td>";
                            htmlResult += "<td>" + (rowData.dispatchQuantity || '0') + "</td>"; // Default to '0' if missing
                            htmlResult += "<td>" + (rowData.unitPrice ? rowData.unitPrice.toFixed(2) : '0.00') + "</td>"; // Handle missing values
                            htmlResult += "<td>" + (rowData.totalPrice ? rowData.totalPrice.toFixed(2) : '0.00') + "</td>"; // Handle missing values
                            htmlResult += "<td>" + (rowData.finalPrice ? rowData.finalPrice.toFixed(2) : '0.00') + "</td>"; // Handle missing values
                            htmlResult += "<td>" + (rowData.difference ? rowData.difference.toFixed(2) : '0.00') + "</td>"; // Handle missing values

                            htmlResult += "</tr>";
                        });


                        $('#tblBillDetailsBody').html(htmlResult);
                        $('#tblBillDetails').show();
                        initializeDataTable();
                    },
                    error: function (xhr, status, error) {
                        console.error(xhr.responseText);
                    }
                });
            }

            function initializeDataTable() {
                if ($.fn.DataTable.isDataTable('#tblBillDetails')) {
                    $('#tblBillDetails').DataTable().destroy();
                }

                $('#tblBillDetails').DataTable({
                    dom: 'Bfrtip',
                    buttons: [
                        'copy', 'csv', 'excel', 'pdf', 'print'
                    ],
                    deferRender: true
                });
            }
        });
    </script>
</body>
</html>




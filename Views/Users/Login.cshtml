@{
    ViewData["Title"] = "Index";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KhanTransport</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KhanTransport.styles.css" asp-append-version="true" />
    <style>
        .container1 {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
        }

        .frame {
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 2rem;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            background-color: #f9f9f9;
            text-align: center;
        }

        .truck-image {
            width: 100%;
            max-width: 300px;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">KhanTransport</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </nav>
    </header>

    <div class="container1">
        <div class="frame">
            <!-- Removed the placeholder image -->
            <main role="main" class="pb-3">
                <div>
                    <form asp-action="Login" asp-controller="Users" method="post" id="frmLogin">
                        <div class="mb-3">
                            <label for="UserName" class="form-label">User Name:</label>
                            <input type="text" name="UserName" id="UserName" class="form-control" placeholder="Enter Email Id" required />
                        </div>
                        <div class="mb-3">
                            <label for="UserPwd" class="form-label">Password:</label>
                            <input type="password" name="UserPwd" id="UserPwd" class="form-control" placeholder="Password" required />
                        </div>
                        <button type="submit" class="btn btn-primary">Login</button>
                    </form>
                    <p class="mt-3">
                        <a asp-action="Create">Create New</a>
                    </p>
                </div>
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2023 - KhanTransport - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
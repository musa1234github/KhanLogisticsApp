<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KhanLogistics</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Added scoped CSS reference for the correct assembly name -->
    <link rel="stylesheet" href="~/KhanLogistics.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/datatablecss/jquery.datatables.css" />
    <link rel="stylesheet" href="~/css/datatablecss/jquery.datatables.min.css" />

    <!-- DataTables JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/datatable/jquery.datatables.min.js"></script>
    <script src="~/datatable/jquery.datatables.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#Mytable').DataTable();

            // Toggle submenus when clicking on the main menu item
            $('.nav-item.has-children > a').on('click', function (e) {
                var submenu = $(this).next('ul');
                if (submenu.is(':visible')) {
                    submenu.slideUp();
                } else {
                    submenu.slideDown();
                }
                e.preventDefault();
            });
        });
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-center">
                        <!-- Main Menu Grouped with Submenus -->
                        <li class="nav-item has-children">
                            <a class="nav-link text-light" href="#">Reports</a>
                            <ul class="tree-menu collapse">
                                <li><a class="nav-link text-light" asp-area="" asp-controller="Report" asp-action="Index">Quantity By Month</a></li>
                                <li><a class="nav-link text-light" asp-area="" asp-controller="Report" asp-action="CheckBills">Bill By Dispatch</a></li>
                                <li><a class="nav-link text-light" asp-area="" asp-controller="Report" asp-action="BillDetail">Bill By Date</a></li>
                                <li><a class="nav-link text-light" asp-area="" asp-controller="Report" asp-action="BillExport">Bill Export</a></li>
                                <li><a class="nav-link text-light" asp-area="" asp-controller="Report" asp-action="ShowDayQty">Show Day Qty</a></li>
                                <li><a class="nav-link text-light" asp-area="" asp-controller="Report" asp-action="DispatchDetails">Dispatch Details</a></li>
                            </ul>
                        </li>
                        <li class="nav-item has-children">
                            <a class="nav-link text-light" href="#">Payment Information</a>
                            <ul class="tree-menu collapse">
                                <li><a class="nav-link text-light" asp-area="" asp-controller="Rep" asp-action="PaymentDetails">Payment Details</a></li>
                                <li><a class="nav-link text-light" asp-area="" asp-controller="Rep" asp-action="SpPaymentByDate">Payment By Date</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                        <a class="nav-link text-light" asp-area="" asp-controller="Gst" asp-action="UploadGst">Upload GST</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Bill" asp-action="Index">GST</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Rep" asp-action="OutstandingDetails">Outstanding</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Vehicle" asp-action="ShowVehicle">Vehicle</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Dispatch" asp-action="ShowDispatch">Short</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Dispatch" asp-action="UploadDispatch">Upload Dispatch</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Invoice" asp-action="UploadBill">Upload Bill</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Rep" asp-action="BillDetailExport">Bill Information</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Bill" asp-action="BillView">Bill</a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Payment" asp-action="ShowBill">Payments</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Invoice" asp-action="ShowBillToDelete">Delete Dispatches</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="JsWCtr" asp-action="JswShipment">Jsw Shipment</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Invoice" asp-action="FetchDispatch">Dispatches NullBill</a>
                        </li>


                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @* <div class="container">
        @await Component.InvokeAsync("NearExpiryReminder")
    </div> *@



    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2023 - KhanLogistics - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    @RenderSection("Scripts", required: false)
</body>
</html>